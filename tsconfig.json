{
  "compilerOptions": {
    "target": "ES6",
    "module": "CommonJS",
    "declaration": true,
    "allowJs": true,
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "Frontend/**/*.ts",
    "API/**/*.js",
    "configs/**/*.ts",
    "configs/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "End-to-end"
  ]
}
